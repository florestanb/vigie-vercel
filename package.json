{
  "name": "vigie",
  "version": "0.1.0",
  "private": true,
  "description": "Vigie : audit et rédaction automatisés des obligations légales d'un site web (droit français et européen).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "NEXT_PUBLIC_VIGIE_SANS_VALIDATION=1 node --import tsx --test tests/*.test.ts",
    "audit": "tsx scripts/audit.ts",
    "registre": "tsx scripts/registre.ts",
    "prospection": "tsx scripts/prospection.ts",
    "sauvegarde": "tsx scripts/sauvegarde.ts",
    "restaurer": "tsx scripts/sauvegarde.ts restaurer",
    "verifier": "tsx scripts/verifier.ts",
    "exemple": "tsx scripts/exemple.ts",
    "citations": "tsx scripts/citations.ts",
    "revue": "tsx scripts/revue.ts",
    "migrer": "tsx scripts/migrer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@sparticuz/chromium": "^153.0.0",
    "axe-core": "^4.14.0",
    "marked": "^15.0.12",
    "next": "^15.5.27",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
