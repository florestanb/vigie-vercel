# Clé de l'API Claude (https://console.anthropic.com). Sans clé, Vigie fait l'audit automatique seul.
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'analyse et la rédaction (par défaut : claude-opus-5-5).
VIGIE_MODELE=claude-opus-5-5
# Chemin vers Chromium ou Chrome si Playwright ne le trouve pas tout seul.
CHROMIUM_PATH=
# Proxy sortant pour le navigateur d'audit, si nécessaire (ex. http://127.0.0.1:3128).
VIGIE_PROXY=
# Dossier où sont stockés les audits (par défaut : ./data/audits).
VIGIE_DONNEES=
# Prospection (npm run prospection) : identité de l'expéditeur, obligatoire dans chaque mail.
VIGIE_EXPEDITEUR_NOM=
VIGIE_EXPEDITEUR_SOCIETE=
VIGIE_EXPEDITEUR_EMAIL=
VIGIE_EXPEDITEUR_TEL=
# Adresse publique de Vigie, pour mettre le lien du rapport complet dans les mails (ex. https://vigie.fr).
VIGIE_URL_PUBLIQUE=
# Espace privé /prospection : mot de passe d'au moins 12 caractères. Sans lui, l'espace est désactivé.
VIGIE_ADMIN_MOTDEPASSE=
# ---------- Paiement et comptes clients ----------
# Clé secrète Stripe (sk_test_… pour les essais, sk_live_… en production) et secret du webhook (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret de signature des sessions client (32 caractères au moins, obligatoire en production).
VIGIE_SECRET=
# Envoi des e-mails (liens de connexion, alertes de suivi) via Resend. Sans clé, en développement, ils s'affichent dans la console.
RESEND_API_KEY=
VIGIE_EMAIL_EXPEDITEUR=Vigie <bonjour@votre-domaine.fr>
# Développement uniquement : 1 pour simuler les paiements sans Stripe.
VIGIE_PAIEMENT_SIMULE=
# 0 pour désactiver la tournée hebdomadaire de suivi des sites des abonnés.
VIGIE_SUIVI=
# 1 si Vigie est derrière un proxy (nginx, Caddy…) : l'adresse du client est lue dans X-Forwarded-For.
# Sans proxy déclaré, les limites d'usage sont communes à tous les visiteurs.
VIGIE_PROXY_DE_CONFIANCE=
# ---------- Exploitation ----------
# Adresse qui reçoit les alertes d'erreur (paiement, webhook, e-mails…), au plus une par type et par heure.
VIGIE_EMAIL_ALERTES=
# Sauvegardes chiffrées quotidiennes de data/ (phrase secrète de 16 caractères au moins, à conserver hors du serveur).
VIGIE_SAUVEGARDE_CLE=
# Dossier des sauvegardes, en dehors de data/ (idéalement synchronisé vers un autre stockage). Par défaut : ./sauvegardes
VIGIE_SAUVEGARDE_DOSSIER=
VIGIE_SAUVEGARDES_A_GARDER=14

# Textes officiels français du registre (npm run citations) : API Légifrance via PISTE (compte gratuit sur piste.gouv.fr,
# application abonnée à l'API « Légifrance »). Sans ces identifiants, seuls les textes européens sont récupérés.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
